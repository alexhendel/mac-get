#!/usr/bin/env python3
"""mac-get: a friendlier face for Homebrew.

Every argument is passed straight to `brew`. Commands that mac-get knows how
to restyle get a live TUI; everything else, and any non-interactive use, runs
brew untouched. Set MAC_GET_PLAIN=1 to always bypass the TUI.

The code lives in the `macget` package next to this file.
"""
import os
import sys

# Resolve the symlink on PATH back to the project directory.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from macget.cli import main  # noqa: E402

main()
